# Copy this file to .env and fill in real values.
# The app runs fine with none of this set — /documents just shows a
# real, honest empty state until Databricks is configured (via this
# file, or the Settings page in the frontend, admin accounts only).

# Comma-separated — add your own machine's LAN IP or tunnel URL here
# too if you need to open the site from another device.
FRONTEND_ORIGINS=http://localhost:3000

# Set a fixed random string in production — tokens won't survive a
# restart otherwise. Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=dev-only-change-me-in-production

# Local dev default assumes MongoDB running on your machine (brew
# services start mongodb-community, or `mongod`). Use a MongoDB Atlas
# connection string here instead for anything beyond local dev.
MONGODB_URI=mongodb://localhost:27017
MONGODB_APP_NAME=Intelligent Project
MONGODB_DB_NAME=Intelligent_Database
MONGODB_USERS_COLLECTION=Authentication
MONGODB_UPLOADS_COLLECTION=Uploads

# Comma-separated emails that get treated as admin (see everything
# platform-wide, manage Databricks connection, trigger the pipeline).
# Everyone else is a regular user — sees only documents they
# personally uploaded. Not stored per-account in MongoDB on purpose;
# this is the only place "who's an admin" is decided.
ADMIN_EMAILS=you@example.com

# --- Databricks (all four required to enable real data) ---
DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
DATABRICKS_TOKEN=dapi...
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/xxxxxxxxxxxxxxxx
DATABRICKS_CATALOG=cdac-project
DATABRICKS_VOLUME_PATH=/Volumes/cdac-project/intelligent-main-folder/raw

# Optional — lets POST /documents/trigger-pipeline start the job that
# runs all 6 notebooks. Find this in the Databricks Jobs UI.
DATABRICKS_JOB_ID=

# --- Claude API (instant AI preview on upload) ---
# Get your own key at https://console.anthropic.com — each person
# running this project should use their own key, not share one.
ANTHROPIC_API_KEY=sk-ant-...
